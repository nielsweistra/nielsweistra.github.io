source "https://rubygems.org"

# GitHub Pages gem
gem "github-pages", group: :jekyll_plugins

# Jekyll plugins
group :jekyll_plugins do
  gem "jekyll-paginate"
  gem "jekyll-sitemap"
  gem "jekyll-seo-tag"
  gem "jekyll-feed"
end

# Windows-specific gems
gem "wdm", "~> 0.1.0", :platforms => [:mswin, :mingw, :x64_mingw]
gem "webrick", "~> 1.7"